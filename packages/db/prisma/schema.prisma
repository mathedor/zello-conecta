// Zello Conecta - Schema do banco de dados
// Marketplace de serviços profissionais

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// AUTH & USERS
// =====================================================

enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  phone         String?    @unique
  phoneVerified DateTime?
  passwordHash  String?
  name          String
  avatarUrl     String?
  role          Role       @default(CLIENT)
  status        UserStatus @default(ACTIVE)

  // Documentos
  cpf       String? @unique
  cnpj      String? @unique
  birthDate DateTime?

  // KYC
  kycStatus     KycStatus @default(PENDING)
  kycSubmittedAt DateTime?
  kycReviewedAt  DateTime?
  kycRejectReason String?

  // Endereço principal
  addressId String?  @unique
  address   Address? @relation(fields: [addressId], references: [id])

  // Relations
  professional      Professional?
  clientBookings    Booking[]      @relation("ClientBookings")
  reviewsWritten    Review[]       @relation("ReviewsWritten")
  notifications     Notification[]
  sessions          Session[]
  accounts          Account[]
  documents         KycDocument[]
  disputes          Dispute[]      @relation("DisputeOpenedBy")
  activityLogs      ActivityLog[]
  pushTokens        PushToken[]
  calendarIntegrations CalendarIntegration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, status])
  @@index([email])
}

// Auth.js tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model KycDocument {
  id       String           @id @default(cuid())
  userId   String
  type     KycDocumentType
  url      String
  status   KycStatus        @default(SUBMITTED)
  notes    String?
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId])
}

enum KycDocumentType {
  CPF_FRONT
  CPF_BACK
  RG_FRONT
  RG_BACK
  CNH
  SELFIE
  PROOF_OF_ADDRESS
  CNPJ_CARD
  OTHER
}

// =====================================================
// PROFESSIONAL
// =====================================================

model Professional {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio          String?  @db.Text
  headline     String?
  hasOwnLocation Boolean @default(false)
  serveOnSite    Boolean @default(true)
  travelFeePerKm Decimal? @db.Decimal(10, 2)
  travelMaxKm    Int?

  // Estatísticas (cache)
  totalBookings   Int      @default(0)
  totalCompleted  Int      @default(0)
  averageRating   Decimal? @db.Decimal(3, 2)
  totalReviews    Int      @default(0)

  // Carteira
  balanceAvailable Decimal @default(0) @db.Decimal(12, 2)
  balancePending   Decimal @default(0) @db.Decimal(12, 2)
  totalEarned      Decimal @default(0) @db.Decimal(12, 2)

  services        Service[]
  schedules       Schedule[]
  scheduleBlocks  ScheduleBlock[]
  bookings        Booking[]       @relation("ProfessionalBookings")
  withdrawTickets WithdrawTicket[]
  payoutAccount   PayoutAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([averageRating])
}

model PayoutAccount {
  id             String       @id @default(cuid())
  professionalId String       @unique
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  pixKey       String?
  pixKeyType   PixKeyType?
  bankCode     String?
  bankName     String?
  agency       String?
  account      String?
  accountType  String?
  holderName   String?
  holderDoc    String?

  updatedAt DateTime @updatedAt
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

// =====================================================
// CATEGORIES & SERVICES
// =====================================================

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  iconName    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  approved    Boolean    @default(false)
  suggestedBy String?

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([approved])
}

enum PriceMode {
  HOURLY
  FIXED
}

enum LocationMode {
  ON_SITE
  PROFESSIONAL_LOCATION
  REMOTE
  BOTH
}

model Service {
  id             String    @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])

  title       String
  slug        String      @unique
  description String      @db.Text
  priceMode   PriceMode
  price       Decimal     @db.Decimal(10, 2)
  durationMin Int
  locationMode LocationMode @default(BOTH)
  active      Boolean     @default(true)

  photos     ServicePhoto[]
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId, active])
  @@index([categoryId])
}

model ServicePhoto {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  caption   String?

  createdAt DateTime @default(now())

  @@index([serviceId])
}

// =====================================================
// SCHEDULE
// =====================================================

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Schedule {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Weekday
  startTime      String
  endTime        String
  active         Boolean      @default(true)

  @@unique([professionalId, weekday, startTime, endTime])
  @@index([professionalId])
}

model ScheduleBlock {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  reason         String?

  @@index([professionalId, startsAt, endsAt])
}

// =====================================================
// BOOKINGS & PAYMENTS
// =====================================================

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PIX
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique @default(cuid())
  clientId       String
  client         User          @relation("ClientBookings", fields: [clientId], references: [id])
  professionalId String
  professional   Professional  @relation("ProfessionalBookings", fields: [professionalId], references: [id])
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])

  scheduledAt    DateTime
  scheduledEnd   DateTime
  durationMin    Int

  // Local
  locationMode   LocationMode
  serviceAddressId String?     @unique
  serviceAddress   Address?    @relation(fields: [serviceAddressId], references: [id])

  // Valores (em centavos para evitar float, mas mantivemos Decimal)
  servicePrice   Decimal       @db.Decimal(10, 2)
  travelFee      Decimal       @default(0) @db.Decimal(10, 2)
  platformFee    Decimal       @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  netToProvider  Decimal       @db.Decimal(10, 2)

  status         BookingStatus @default(PENDING_PAYMENT)
  notesFromClient String?      @db.Text
  notesFromProvider String?    @db.Text

  // Conclusão
  completedByClient   Boolean   @default(false)
  completedAt         DateTime?
  autoReleaseAt       DateTime?
  releasedAt          DateTime?

  payment       Payment?
  review        Review?
  dispute       Dispute?
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, scheduledAt])
  @@index([professionalId, scheduledAt])
  @@index([status])
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id])

  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("BRL")

  // Stripe
  stripePaymentIntentId String?  @unique
  stripeChargeId        String?

  // Efí PIX
  efiTxId               String?  @unique
  efiQrCode             String?  @db.Text
  efiQrCodeImageUrl     String?
  efiCopyPaste          String?  @db.Text
  efiExpiresAt          DateTime?

  paidAt        DateTime?
  failedReason  String?

  // Escrow
  escrowStatus  EscrowStatus  @default(HELD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([escrowStatus])
}

// =====================================================
// REVIEWS & DISPUTES
// =====================================================

model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User    @relation("ReviewsWritten", fields: [authorId], references: [id])

  rating    Int
  comment   String? @db.Text
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  RESOLVED_RELEASED
  CLOSED
}

model Dispute {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  booking    Booking       @relation(fields: [bookingId], references: [id])
  openedById String
  openedBy   User          @relation("DisputeOpenedBy", fields: [openedById], references: [id])

  status     DisputeStatus @default(OPEN)
  reason     String        @db.Text
  resolution String?       @db.Text
  resolvedAt DateTime?

  messages DisputeMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([disputeId])
}

// =====================================================
// WITHDRAWS
// =====================================================

enum WithdrawStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

model WithdrawTicket {
  id             String         @id @default(cuid())
  professionalId String
  professional   Professional   @relation(fields: [professionalId], references: [id])
  amount         Decimal        @db.Decimal(12, 2)
  status         WithdrawStatus @default(REQUESTED)

  pixKey       String?
  pixKeyType   PixKeyType?
  bankSnapshot Json?

  receiptUrl     String?
  processedAt    DateTime?
  processedById  String?
  rejectReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([professionalId])
}

// =====================================================
// ADDRESS & GEOLOCATION
// =====================================================

model Address {
  id          String  @id @default(cuid())
  zipCode     String
  street      String
  number      String?
  complement  String?
  district    String
  city        String
  state       String
  country     String  @default("BR")
  latitude    Float?
  longitude   Float?
  reference   String?

  user    User?
  booking Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, state])
  @@index([zipCode])
}

// =====================================================
// NOTIFICATIONS & CALENDAR
// =====================================================

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  WITHDRAW_PROCESSED
  WITHDRAW_REJECTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  KYC_APPROVED
  KYC_REJECTED
  GENERIC
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking?            @relation(fields: [bookingId], references: [id])
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String              @db.Text
  metadata  Json?
  readAt    DateTime?
  sentAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([type])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
}

enum CalendarProvider {
  GOOGLE
  ICAL
}

model CalendarIntegration {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     CalendarProvider
  accessToken  String?          @db.Text
  refreshToken String?          @db.Text
  expiresAt    DateTime?
  calendarId   String?
  active       Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

// =====================================================
// AUDIT
// =====================================================

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
